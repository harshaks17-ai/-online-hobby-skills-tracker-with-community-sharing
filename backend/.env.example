# --- runtime ---------------------------------------------------------------
ENVIRONMENT=local
DEBUG=true
HOST=0.0.0.0
PORT=8000

# --- secrets (NEVER commit the real .env) ----------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS: comma separated list of allowed origins --------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- cloud service providers ------------------------------------------------
# local = bundled emulator (zero setup) | gcp = Cloud SQL + Cloud Storage | aws = RDS + S3
DATABASE_PROVIDER=local
STORAGE_PROVIDER=local
IDENTITY_PROVIDER=local
STORAGE_BUCKET=local-emulator-bucket
# When DATABASE_PROVIDER != local, point this at the managed instance:
# SQLITE_PATH=postgresql+psycopg://user:pass@host:5432/hobbylog
SQLITE_PATH=
STORAGE_ROOT=

# --- uploads ---------------------------------------------------------------
MAX_UPLOAD_BYTES=8388608
ALLOWED_UPLOAD_TYPES=image/png,image/jpeg,image/jpg,image/webp,image/gif,image/svg+xml,application/pdf,video/mp4,text/plain
SIGNED_URL_TTL_SECONDS=3600

# --- rate limiting ---------------------------------------------------------
# The general budget is per client IP across every non-auth API path. A single
# SPA page load fans out into half a dozen parallel requests, and rapid
# navigation (or an automated browser run) legitimately bursts into the
# hundreds per minute, so this is set high enough to never annoy a real user.
# The meaningful abuse control is AUTH_RATE_LIMIT_REQUESTS below: sign-in and
# registration get their own per-path bucket.
RATE_LIMIT_REQUESTS=1200
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=12

# --- demo data -------------------------------------------------------------
SEED_ON_STARTUP=true
DEMO_PASSWORD=pass1234
