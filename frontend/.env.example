# --- frontend runtime configuration ---------------------------------------
# The Vite dev server proxies /api and /media to the backend, so the app uses a
# same-origin API path by default (no CORS, and identical to a CDN + gateway).
VITE_API_BASE=

# Only needed when the API lives on a different origin. Leave empty locally.
VITE_BACKEND_URL=http://127.0.0.1:8000

# Branding shown in the UI.
VITE_APP_NAME=HobbyLog
VITE_APP_TAGLINE=Track every skill. Share every win.
